# ==============================================================================
# NNOO — Africa's AI Business Operating System
# Authoritative Environment Configuration Template (.env.example)
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL WEB DEVELOPMENT
# NEVER COMMIT REAL PRODUCTION SECRETS OR VALUES TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & APPLICATION ENVIRONMENT IDENTIFIER
# ------------------------------------------------------------------------------
# Explicit environment mode: 'development' | 'preview' | 'production' | 'test'
NNOO_ENV=development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE / PUBLIC CONFIGURATION (WEB & BROWSER)
# ------------------------------------------------------------------------------
# These variables are prefixed with NEXT_PUBLIC_ and are bundled into client JS.
# NEVER put service role keys, API secrets, or private tokens under NEXT_PUBLIC_.

# Supabase Canonical API Gateway URL (Web client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Public API Key (Protected by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Web Application Public Origin URL (Used for auth redirects, deep links, and invoices)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack Client-Safe Public Key (Optional, for client popup checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ------------------------------------------------------------------------------
# 3. CLIENT-SAFE / PUBLIC CONFIGURATION (EXPO MOBILE APP)
# ------------------------------------------------------------------------------
# These variables are prefixed with EXPO_PUBLIC_ and bundled into native mobile apps.
# Mobile Production points to the SAME canonical Supabase backend as Web.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
EXPO_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SERVER-ONLY / PRIVILEGED CORE BACKEND SECRETS (VERCEL / PRODUCTION VAULT)
# ------------------------------------------------------------------------------
# These variables must NEVER be exposed to browser or mobile client bundles.

# Supabase Service Role Key (Bypasses RLS — Server background and Admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 5. PAYSTACK RECURRING SAAS BILLING CONFIGURATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Mode must match NNOO_ENV: sk_test_* for development/preview, sk_live_* for production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_ENVIRONMENT=test

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI SERVER FOUNDATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Official Google AI Studio / Vertex API Key for server-only Gemini client.
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
AI_ENABLED=true
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 7. META WHATSAPP BUSINESS PLATFORM CLOUD API (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Official Meta Cloud API (v20.0) System User Token and Phone Identity.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_ACCESS_TOKEN=EAAG_your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_for_webhook_signature_hmac
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_challenge_verify_token
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_PEPPER=your_cryptographic_pepper_string_for_phone_hashing

# ------------------------------------------------------------------------------
# 8. INNGEST SERVERLESS DURABLE JOB ORCHESTRATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Cloud signing and event keys for background intelligence jobs and schedules.
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
INNGEST_APP_ID=nnoo-web

# ------------------------------------------------------------------------------
# 9. EXPO PUSH NOTIFICATIONS SERVER CREDENTIAL (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Server access token for dispatching push notifications to Expo Push API.
EXPO_ACCESS_TOKEN=your_expo_access_token_here
